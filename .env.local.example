# D-20: a apiKey do Firebase e publica por design - ela identifica o projeto,
# nao protege dado nenhum. Quem protege os dados sao as Security Rules
# (firestore.rules). Copie este arquivo para .env.local e preencha com os
# valores do console do Firebase; .env.local nunca e versionado.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_USE_EMULATORS=true
