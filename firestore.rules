rules_version = '2';

// Ponto de partida: nega tudo. As regras reais de /users/{uid} e
// /workspaces/{workspaceId} entram na Task 3 deste plano. Este arquivo nunca
// pode ser afrouxado para liberar leitura/escrita a qualquer chamador
// autenticado só para destravar desenvolvimento local — o emulador roda
// contra o mesmo arquivo que vai para produção.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
