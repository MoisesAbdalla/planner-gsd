rules_version = '2';

// Task 3 (01-01): as regras reais de /users/{uid} e /workspaces/{workspaceId}.
// Task 1 (01-02): a ramificação de update que permite ENTRAR por convite
// (o caso "!(uid in memberIds)") e a coleção /invites/{token} — ver
// 01-RESEARCH.md §O desenho central. Nenhum match genérico permissivo
// permanece: qualquer path não coberto continua negado pela ausência de
// regra. Isso nunca pode ser afrouxado para destravar desenvolvimento
// local — o emulador roda contra o mesmo arquivo que vai para produção.
service cloud.firestore {
  match /databases/{database}/documents {

    // Ponto único de isolamento (D-25). Ainda sem consumidor nesta task —
    // os planos 01-02 e 01-03 dependem dela para as subcoleções do
    // workspace (categories, transactions, etc.).
    function isMember(wsId) {
      return request.auth != null &&
        request.auth.uid in
          get(/databases/$(database)/documents/workspaces/$(wsId)).data.memberIds;
    }

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.workspaceId is string;

      // workspaceId é imutável depois de criado (AUTH-01 concurrency).
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.workspaceId == resource.data.workspaceId;

      allow delete: if false;
    }

    match /workspaces/{workspaceId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.memberIds;

      allow create: if request.auth != null
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0;

      // Duas ramificações independentes (OR): (1) atualização normal por
      // membro já existente (ex.: renomear o espaço) — memberIds não muda
      // por este caminho; (2) entrada por convite (01-02) — acrescentar UM
      // novo uid, e só quando o token SUBMETIDO PELO CHAMADOR agora
      // (request.resource.data.joinToken) resolve, via get(), a um convite
      // pendente e não expirado deste workspace. O ponto que faz esta
      // ramificação segura é exatamente este: o token vem do payload que o
      // chamador está enviando agora, nunca de uma busca por "existe algum
      // convite pendente para este espaço" — essa segunda forma permitiria
      // qualquer usuário autenticado entrar em qualquer espaço com convite
      // aberto, mesmo sem jamais ter visto o link (01-RESEARCH.md §2,
      // Pitfall 2, T-01-02 no <threat_model> do plano 01-02).
      allow update: if request.auth != null && (
        // WR-01: ramo de "membro já existente atualizando" — só pode tocar
        // `name` (o único campo que WorkspaceNameField grava). memberIds
        // sem mudança + affectedKeys().hasOnly(['name']) juntos já tornam
        // ownerId/createdAt imutáveis por este ramo sem precisar checá-los
        // um a um: qualquer chave que mude vira uma affected key e reprova
        // o hasOnly. Entrada de membro (memberIds crescendo) continua
        // vivendo só no segundo ramo, abaixo.
        (request.auth.uid in resource.data.memberIds
          && request.resource.data.memberIds == resource.data.memberIds
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80)
        ||
        (
          !(request.auth.uid in resource.data.memberIds)
          && request.resource.data.memberIds ==
               resource.data.memberIds.concat([request.auth.uid])
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['memberIds', 'joinToken'])
          && get(/databases/$(database)/documents/invites/$(request.resource.data.joinToken)).data.workspaceId == workspaceId
          && get(/databases/$(database)/documents/invites/$(request.resource.data.joinToken)).data.status == 'pending'
          && get(/databases/$(database)/documents/invites/$(request.resource.data.joinToken)).data.expiresAt > request.time
          && !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        )
      );

      allow delete: if false;

      // Subcoleção de categorias do workspace (categoryId) — CAT-01..04,
      // AUTH-06/07 (plano 01-04). Regra ESPECÍFICA que coexiste em OR com o
      // bloco genérico de isolamento logo abaixo (Firestore avalia todos os
      // match blocks que casam o mesmo path e permite se QUALQUER um
      // autorizar) — este bloco é o único que ABRE escrita em categories,
      // o genérico continua fechado para write.
      match /categories/{categoryId} {
        allow read: if isMember(workspaceId);

        // WR-02: `archivedAt`/`canArchive`/`isSystemDefault` agora são
        // exigidos com o tipo certo no create — sem isso, um create forjado
        // que omite `archivedAt` deixa o campo `undefined`, e o filtro
        // `archivedAt !== null` de useCategories.ts (T-01-04-adjacent)
        // classifica a categoria recém-criada como já arquivada.
        allow create: if isMember(workspaceId)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80
          && request.resource.data.color is string
          && request.resource.data.color.size() <= 40
          && request.resource.data.archivedAt == null
          && request.resource.data.canArchive is bool
          && request.resource.data.isSystemDefault is bool;

        // Trava de servidor para "Outros nunca arquiva" (D-11, CAT-04,
        // T-01-18): nega qualquer update que defina archivedAt != null num
        // documento cujo canArchive ARMAZENADO (resource.data, não o
        // payload) já é false — defesa em profundidade sobre o botão
        // desabilitado do cliente, fecha o caso de requisição forjada.
        // WR-02: além disso, um update só pode tocar name/color/archivedAt
        // (nunca canArchive/isSystemDefault, que são fixados na criação e
        // nunca podem mudar por este caminho — é exatamente essa lacuna que
        // permitia forjar canArchive/isSystemDefault via update direto).
        // `createdAt` entra na allowlist por um motivo diferente de
        // segurança: seed.ts semeia com um `writeBatch` de `set()` (grava o
        // documento inteiro, não um merge parcial) e o teste permanente
        // "seed/concorrência" (tests/categories.test.ts) prova, contra o
        // emulador real, que dois seedings concorrentes do mesmo espaço
        // devem convergir — quando o segundo batch perde a corrida e
        // reescreve um documento que o primeiro já criou, o
        // `serverTimestamp()` do `createdAt` resolve para um instante
        // diferente do já gravado, e last-write-wins é o comportamento
        // aceito conscientemente para concorrência (D-21). Não é uma
        // brecha: name/color continuam validados, e canArchive/
        // isSystemDefault continuam fora da allowlist, então mudá-los via
        // update (a única coisa que este WR-02 precisa fechar) segue negado.
        allow update: if isMember(workspaceId)
          && !(resource.data.canArchive == false
               && request.resource.data.archivedAt != null)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['name', 'color', 'archivedAt', 'createdAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80
          && request.resource.data.color is string
          && request.resource.data.color.size() <= 40;

        // Nunca excluir — arquivar preserva o histórico (D-11, CAT-04); um
        // categoryId já gravado num lançamento das fases seguintes precisa
        // continuar resolvendo. Nenhum chamador, nem o próprio criador,
        // pode excluir (T-01-19).
        allow delete: if false;
      }

      // Isolamento genérico para qualquer subcoleção direta do workspace
      // (categories chega no 01-04; transactions/tasks em fases seguintes)
      // — leitura sempre gated por isMember(); toda escrita fica fechada
      // aqui de propósito. Firestore faz OR entre match blocks que casam o
      // mesmo path, então uma regra de escrita mais específica adicionada
      // depois (com validação de campos) só ABRE permissão, nunca precisa
      // remover este bloco — e este bloco nunca afrouxa o que vier depois.
      match /{subcollection}/{docId} {
        allow read: if isMember(workspaceId);
        allow write: if false;
      }
    }

    // /invites/{token} — coleção de NÍVEL RAIZ, token = ID do documento
    // (01-RESEARCH.md §O desenho central §1). NUNCA subcoleção do workspace:
    // D-01 diz que a URL do convite carrega um único código; uma subcoleção
    // /workspaces/{workspaceId}/invites/{token} exigiria dois identificadores
    // na URL e cria dependência circular (precisar do workspaceId para
    // endereçar o próprio convite que revela o workspaceId).
    match /invites/{token} {
      // Aberto a qualquer autenticado por ID exato — a segurança não vem de
      // restringir quem lê um ID conhecido, vem de ninguém conseguir
      // DESCOBRIR esse ID sem já possuir o link. `list` fecha essa porta.
      allow get: if request.auth != null;
      allow list: if false;

      allow create: if request.auth != null
        && isMember(request.resource.data.workspaceId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.usedBy == null
        && request.resource.data.createdAt == request.time
        // Igualdade estrita com request.time + duration.value(7, 'd') não é
        // praticável a partir do cliente (o cliente não sabe o instante
        // exato em que o servidor vai avaliar request.time no commit) —
        // relaxado para uma faixa, conforme o próprio <action> do plano
        // 01-02 previu como fallback. A checagem de prazo nunca é removida
        // por inteiro. Ver SUMMARY desta execução.
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt < request.time + duration.value(8, 'd');

      // Só a transição pending -> used, e só tocando estes três campos —
      // ninguém redireciona o convite mudando workspaceId/createdBy na
      // mesma escrita (T-01-06).
      allow update: if request.auth != null
        && resource.data.status == 'pending'
        && resource.data.expiresAt > request.time
        && request.resource.data.status == 'used'
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.usedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'usedBy', 'usedAt']);

      allow delete: if false;
    }
  }
}
